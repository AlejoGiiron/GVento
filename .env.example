VITE_GVENTO_SUPABASE_URL=https://your-project-id.supabase.co
VITE_GVENTO_SUPABASE_ANON_KEY=your-anon-public-key-here

# ── Sentry (reporte de errores) ──────────────────────────────────────────────
# Todas OPCIONALES: sin DSN, Sentry queda desactivado y la app funciona igual.
# Sentry SOLO se inicializa en builds de producción (nunca en dev ni en E2E).

# DSN del proyecto. Es público por diseño (viaja en el bundle del navegador).
VITE_SENTRY_DSN=
# production | staging — etiqueta los eventos por ambiente.
VITE_SENTRY_ENVIRONMENT=production
# Versión del release, para atribuir errores a un deploy. En Vercel:
#   VITE_SENTRY_RELEASE=$VERCEL_GIT_COMMIT_SHA
VITE_SENTRY_RELEASE=

# ── Portal del cliente (pedido.html): el mapa. Opcionales en desarrollo; en producción, las tres
# antes de abrir el portal (docs/plan-pedidos-en-linea.md → "P2 · el mapa del portal").
VITE_PORTAL_MAPA_URL=
VITE_PORTAL_MAPA_GLIFOS=
VITE_PORTAL_MAPA_SPRITE=

# ── Solo para el BUILD (sin prefijo VITE_: no entran al bundle) ──────────────
# ⚠️ SENTRY_AUTH_TOKEN es un SECRETO. Va en las env vars de Vercel, NUNCA acá
#    ni en ningún archivo versionado. Sin él, el build no sube source maps.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
