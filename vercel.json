{
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "pedir.gvento.online"
        }
      ],
      "destination": "/pedido.html"
    },
    {
      "source": "/pedir",
      "destination": "/pedido.html"
    },
    {
      "source": "/pedir/(.*)",
      "destination": "/pedido.html"
    },
    {
      "source": "/m",
      "destination": "/movil.html"
    },
    {
      "source": "/m/(.*)",
      "destination": "/movil.html"
    },
    {
      "source": "/cocina",
      "destination": "/cocina.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
